# Secret Manager に登録する secrets.toml の見本（本物はGitに入れない）
[auth]
redirect_uri = "https://【公開URL】/oauth2callback"
cookie_secret = "【ランダムな長い文字列】"
client_id = "【OAuthクライアントID】.apps.googleusercontent.com"
client_secret = "【OAuthクライアントシークレット】"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Googleスプレッドシートの読み書き（上と同じOAuthクライアントを使う。戻り先はアプリのURLそのもの）
[google_oauth]
client_id = "【OAuthクライアントID】.apps.googleusercontent.com"
client_secret = "【OAuthクライアントシークレット】"
redirect_uri = "https://【公開URL】"

[app]
# 「塾と利用者の管理」を使える運営者のGoogleアカウント
admins = ["【運営者のメールアドレス】"]
